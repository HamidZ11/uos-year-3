{% extends 'default/layout.html.twig' %}

{% block title %}Contacts{% endblock %}

{% block content %}
    <table>
        <caption>Contacts</caption>
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
            </tr>
        </thead>
        <tbody>
            {% for contact in contacts %}
                <tr>
                    <td>{{ contact.name }}</td>
                    <td>{{ contact.email }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
